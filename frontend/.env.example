# Host-side port for the compiled frontend (the container listens on port 80).
FRONTEND_PORT=5173

# Docker service and port used by Nginx to proxy /api requests.
BACKEND_HOST=backend
BACKEND_PORT=8000

# Used only by the Vite development server, not by the production image.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
