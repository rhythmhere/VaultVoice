ENVIRONMENT=development
APP_NAME=VaultVoice API
FRONTEND_PORT=5173
BACKEND_PORT=8000
MINIO_CONSOLE_PORT=9001

POSTGRES_DB=vaultvoice
POSTGRES_USER=vaultvoice
POSTGRES_PASSWORD=vaultvoice
DATABASE_URL=postgresql+psycopg://vaultvoice:vaultvoice@postgres:5432/vaultvoice
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://vaultvoice.app,https://www.vaultvoice.app

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=VaultVoice

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=vaultvoice-evidence
MINIO_SECURE=false

BACKEND_HOST=backend

# Used by the Vite development server when running the frontend locally.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Used by the backend for standalone/local execution.
PORT=8000

# Generate with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
VAULTVOICE_ENCRYPTION_KEY=
MAX_UPLOAD_BYTES=52428800
RATE_LIMIT=60/minute
