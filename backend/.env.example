# Backend settings. Compose injects these values from the repository .env file.
ENVIRONMENT=development
APP_NAME=VaultVoice API
PORT=8000
DATABASE_URL=postgresql+psycopg://vaultvoice:vaultvoice@postgres:5432/vaultvoice
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=VaultVoice

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=vaultvoice-evidence
MINIO_SECURE=false

# Base64 URL-safe encoding of exactly 32 random bytes.
VAULTVOICE_ENCRYPTION_KEY=
MAX_UPLOAD_BYTES=52428800
RATE_LIMIT=60/minute
